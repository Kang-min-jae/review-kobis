# 로컬 개발용 환경 변수 예시 — 이 파일을 .env.local로 복사해서 쓴다(.env.local은 저장소에 올라가지 않는다).
# .env.local은 next dev와 scripts/*.mts가 모두 읽고, .env보다 우선한다.

# 로컬 DB(docker compose up -d). 운영 DB(Neon) 주소는 여기에 넣지 않는다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/review_local?sslmode=disable"

# 로그인 쿠키 서명용 — 아무 긴 문자열(운영 값과 다르게)
AUTH_SECRET="local-dev-secret-change-me"

# 외부 API 키는 기존 .env의 값을 그대로 써도 된다(DB 전송량과 무관).
# TMDB_API_KEY=...
# KOFIC_API_KEY=...
# KMDB_API_KEY=...
