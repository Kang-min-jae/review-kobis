// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// 영화 상세정보 캐시(KOBIS+KMDb를 합쳐 만든 결과) — 특정 영화 하나를 볼 때만
// 필요한 long-tail 데이터라, 요청이 들어올 때 없거나 오래됐으면 그때 채워 넣는다
// (lazy cache).
model CachedMovie {
  movieCd        String   @id
  title          String
  titleEn        String?
  posterUrl      String?
  overview       String?
  releaseDate    String? // ISO yyyy-mm-dd
  rereleaseDate  String?
  runtimeMinutes Int?
  watchGrade     String?
  genreAlt       String?
  directorName   String?
  directorKmdbId String?
  // findMoviesByCastTmdbId(person-filmography.ts) 역방향 조회용 — 이름으로 TMDB
  // 인물을 찾아본 결과(동명이인이면 null로 남는다).
  directorTmdbId String?
  cast           Json // { name: string; kmdbId: string | null; tmdbId: string | null }[]
  // KOFIC/KMDb 둘 다 실패했거나 포스터가 없어서 TMDB로 보완한 경우에만 채워진다.
  tmdbId         String?
  // 포스터/줄거리/장르 등을 최종적으로 어느 소스에서 가져왔는지 — "kmdb"(기본,
  // KOFIC+KMDb 조합) | "tmdb"(KMDb에 없어서 TMDB로 보완함).
  source         String   @default("kmdb")
  updatedAt      DateTime @updatedAt

  // ILIKE '%query%' 검색 속도를 위한 GIN trigram 인덱스 (전체 테이블 스캔 제거)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

// TV 시리즈 상세정보 캐시 — TMDB /tv/{id} 응답을 저장한다. CachedMovie와 달리
// KOBIS 데이터가 없어서 TMDB 단일 소스다.
model CachedSeries {
  tmdbId       String   @id
  name         String
  originalName String?
  posterUrl    String?
  overview     String?
  firstAirDate String? // ISO yyyy-mm-dd (첫 방영일)
  genreAlt     String? // 콤마 구분 장르명
  seasonCount  Int?
  updatedAt    DateTime @updatedAt
}

// 인물 필모그래피 캐시 — 마찬가지로 그 인물 페이지를 볼 때만 필요한 long-tail
// 데이터라 lazy cache로 채운다.
model CachedPerson {
  kmdbId      String   @id
  name        String
  role        String // "감독" | "배우"
  filmography Json // RowMovie[]
  // 이름으로 TMDB 인물 검색을 해서 한 번 찾아낸 person_id — 한 번 찾으면 캐시가
  // 신선한 동안은 재검색하지 않는다. 확정 판정이 아니라 이름 기반 매칭이라 완전히
  // 정확하다는 보장은 없다(person-filmography.ts의 filmographyFromTmdb 참고).
  tmdbId      String?
  // 톰 홀랜드·맷 데이먼 같은 외국 인물의 영문 본명 — TMDB는 영문 이름으로만
  // 등록돼 있어서, 한글 이름으로 검색하면 못 찾는다. KMDb 원본 크레딧에서
  // 추출해 여기 저장해두면 캐시가 만료돼 다시 계산할 때 재추출 없이 바로 쓸 수 있다.
  nameEn      String?
  updatedAt   DateTime @updatedAt

  // name / nameEn ILIKE 검색을 위한 GIN trigram 인덱스
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin)
}

// 박스오피스 순위·이 달의 Best처럼 자주 조회되는 랭킹류 목록 — 요청마다 새로
// 계산하지 않고 하루 1~2회 배치로 미리 갱신해둔다.
model RankingSnapshot {
  id         Int      @id @default(autoincrement())
  listType   String // "weekly_box_office" | "monthly_best" 등
  rank       Int
  movieCd    String
  movieTitle String
  audiAcc    Int
  syncedAt   DateTime @default(now())

  @@index([listType, syncedAt])
}

// 재개봉 여부 판정 캐시 — KOFIC 박스오피스/카탈로그와 KMDb 개봉일·제작연도를 대조해서
// 신작인지 재개봉작인지 가리는 작업(영화 하나당 KMDb 검색 + KOBIS 원 개봉 대조까지 필요)은
// API 호출이 많이 들어서 요청마다 다시 계산하지 않는다. scripts/refresh-rerelease-
// classifications.mts가 하루 1회 배치로 미리 계산해 여기 저장해두면, 프론트엔드
// (movie-rows.ts)는 이 표에 저장된 값만 읽는다.
model RereleaseClassification {
  movieCd         String   @id
  movieTitle      String
  isRerelease     Boolean
  originalYear    String? // 원작 제작/개봉 연도(YYYY) — isRerelease=false면 null
  rereleaseDate   String? // 이번 재개봉일(ISO) — isRerelease=false면 null
  audiAcc         Int? // 판정 시점 기준 누적 관객수(박스오피스에 있으면) — "인기 재개봉작" 정렬용
  // 장르 필터링용(콤마 구분, KOBIS/KMDb 원본 표기 그대로) — 판정 과정에서 이미 조회한
  // KMDb 결과에서 얻으므로 추가 API 호출이 들지 않는다. 이 값이 없으면(장르를 못
  // 찾음) 장르 필터에서 항상 제외된다.
  genreAlt        String?
  // "classified": 자동/수동으로 신작·재개봉 여부가 정해짐 · "unclassified": 자동 판정 근거가
  // 전혀 없어 수동 검수가 필요함(관리자가 scripts/manage-rerelease-override.mts로 확정해야 함).
  status          String   @default("classified")
  // 어떤 근거로 판정했는지: "kmdb-release-date" | "kobis-earliest-registration" |
  // "title-keyword" | "year-gap-heuristic" | "new-release" | "manual"
  source          String
  manualConfirmed Boolean  @default(false) // true면 다음 배치가 덮어쓰지 않는다
  syncedAt        DateTime @default(now())

  @@index([isRerelease, status])
}

// 영화제 수상작 캐시 — Wikidata SPARQL 결과를 하루 1회 저장해 429 반복 호출을 방지한다.
model CachedAwardWinners {
  id        String   @id // "academy" | "cannes" | "berlin" | "venice"
  winners   Json // FestivalWinner[]
  updatedAt DateTime @updatedAt
}

// ── 로그인 (Auth.js) ─────────────────────────────────────────────────────
// User/Account/Session/VerificationToken은 Auth.js의 PrismaAdapter가 요구하는
// 정확한 형태 그대로다 — 필드명을 바꾸면 어댑터가 못 찾는다. nickname/totalLikes만
// 이 사이트에서 쓰려고 추가한 필드.
// 참고: https://authjs.dev/getting-started/adapters/prisma

model User {
  id                 String    @id @default(cuid())
  name               String? // OAuth 제공자가 준 원래 이름
  nickname           String?   @unique // 다른 사람에게 보여지는 표시 이름. 중복 불가(NULL은 여러 개 허용).
  username           String?   @unique // 크레덴셜 로그인용 아이디 — 소셜 가입 유저는 null
  email              String?   @unique // 비밀번호 찾기·소셜 로그인용. 카카오는 동의 안 받으면 null
  emailVerified      DateTime?
  image              String?
  password           String? // 이메일/비밀번호 로그인용 해시(bcrypt) — OAuth로만 가입한 사용자는 null
  role               String    @default("USER") // "USER" | "ADMIN"
  totalLikes         Int       @default(0) // 등급(관객/씨네필/평론가/거장) 계산용 반정규화
  profileViewsTotal  Int       @default(0) // 다른 사용자가 내 프로필을 방문한 누적 횟수
  profileViewsToday  Int       @default(0) // 오늘(profileViewsDate 기준) 방문 횟수
  profileViewsDate   String? // 오늘 카운터를 마지막으로 초기화한 날짜(yyyy-mm-dd)
  alwaysShowSpoilers Boolean   @default(false) // "스포일러 항상 보기" — 켜면 스포일러 한줄평도 바로 펼쳐 보인다

  accounts           Account[]
  sessions           Session[]
  reviews            Review[]
  reviewLikes        ReviewLike[]
  categoryRatings    CategoryRating[]
  following          Follow[]            @relation("Following")
  followers          Follow[]            @relation("Followers")
  watchTriggers      WatchTrigger[]      @relation("Reader")
  passwordResetCodes PasswordResetCode[]
  awardVotes         AwardVote[]
  inquiries          Inquiry[]
  termsConsent       TermsConsent?
  spoilerReports     SpoilerReport[]

  createdAt DateTime @default(now())
}

// 비밀번호 재설정용 6자리 OTP 코드. 링크 방식 대신 코드 입력 방식으로 전환.
// Auth.js의 VerificationToken과 목적이 달라 별도 모델로 유지한다.
model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade)
  code      String // 6자리 난수 (예: "482910")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── 리뷰·평점 소셜 기능 ──────────────────────────────────────────────────

model Review {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  movieCd  String
  // "전체" | "연출" | "연기" | "각본" | "음악" | "편집" — category-ratings-store.ts의
  // RATING_CATEGORIES와 같은 값을 그대로 쓴다(번역 레이어 없이 1:1 매칭).
  category String     @default("전체")
  type     ReviewType
  content  String
  rating   Float // 한줄평 0~10, 장문평 0~100 — 지금 화면 스케일 그대로

  // 스포일러 표시(is_spoiler). 작성자가 "스포일러가 있어요"를 체크했거나, 다른 회원 신고가
  // SPOILER_REPORT_THRESHOLD명을 넘으면 켜진다. 켜진 리뷰는 본문을 가리고 눌러야 불러온다.
  hasSpoiler        Boolean   @default(false)
  spoilerLevel      Int       @default(0)
  // 누가 스포일러로 표시했는지 — "author"(작성자 체크) | "reports"(신고 누적) | "keyword"(예전 자동 감지) | null
  spoilerFlagSource String?
  spoilerFlaggedAt  DateTime? // 신고 누적으로 표시된 시각 — 작성자 알림에 쓴다
  likeCount         Int       @default(0) // 반정규화 — 좋아요 받을 때마다 트랜잭션으로 같이 갱신
  dislikeCount      Int       @default(0) // 반정규화 — 싫어요는 등급(totalLikes) 계산엔 안 들어간다
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  likes          ReviewLike[]
  watchTriggers  WatchTrigger[]
  spoilerReports SpoilerReport[]

  // 한 사람은 같은 영화의 같은 항목·타입(한줄평/장문평)에 리뷰를 하나만 남긴다 —
  // 다시 등록하면 새로 만들지 않고 그 리뷰를 수정한다.
  @@unique([userId, movieCd, category, type])
  @@index([movieCd, category, type])
}

enum ReviewType {
  SHORT
  LONG
}

// 항목별 페이지 위쪽의 빠른 별점(글 없이 숫자만) — 한줄평/장문평(Review)과는 별개다.
// 한 유저가 같은 영화의 같은 항목엔 점수 하나만 남긴다(1인 1표, upsert).
model CategoryRating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieCd   String
  category  String // Review.category와 같은 값("전체"/"연출"/"연기"/"각본"/"음악"/"편집")
  score     Float // 0.0 ~ 10.0
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, movieCd, category])
  @@index([movieCd, category])
}

// 리뷰 좋아요/싫어요 — 좋아요는 등급(관객/씨네필/평론가/거장) 계산의 핵심 데이터,
// 싫어요는 표시용(dislikeCount)일 뿐 등급엔 영향 없음. 한 사람이 한 리뷰에 남길 수
// 있는 투표는 하나뿐이라(좋아요 누른 뒤 싫어요를 누르면 좋아요가 싫어요로 바뀐다).
model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VoteType @default(LIKE)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

enum VoteType {
  LIKE
  DISLIKE
}

// 평론가 팔로우.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// "이 리뷰 때문에 봤어요" 추적.
model WatchTrigger {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  readerId  String
  reader    User     @relation("Reader", fields: [readerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, readerId])
}

// 필모그래피 자동 매칭(동명이인 구분 등)이 못 잡아내는 경우를 위한 수동 예외.
// KMDb 원본 데이터 자체의 오류처럼 우리 로직으로는 못 고치는 경우, 사람이 직접
// "이 인물의 이 영화는 빼라/넣어라"를 등록해두면 다음 캐시 갱신부터 반영된다.
model PersonFilmographyOverride {
  id           String                          @id @default(cuid())
  personKmdbId String
  movieCd      String
  action       PersonFilmographyOverrideAction
  reason       String?
  createdAt    DateTime                        @default(now())

  @@unique([personKmdbId, movieCd])
  @@index([personKmdbId])
}

enum PersonFilmographyOverrideAction {
  EXCLUDE
  INCLUDE
}

// 이름만으로는 동명이인을 구분할 근거가 없는 경우를 위한 화이트리스트. "황정민"처럼
// 자주 검색되고 이미 동명이인 문제가 실제로 확인된 이름을, 사람이 직접 확인한
// kmdbId(+가능하면 KOFIC peopleCd)로 미리 확정해둔다. movie-rate-info.ts가 영화
// cast의 이름에 kmdbId를 역조회(resolvePersonId)하기 전에 이 테이블을 먼저 확인해서,
// 등록된 이름이면 검색 기반 추정 대신 이 확정값을 그대로 쓴다.
// koficPeopleCd는 KOFIC 영화인 상세정보 API 구조가 아직 완전히 검증되지 않아 우선
// nullable로 둔다 — 검증되면 채워 넣는다.
model PersonIdentityMapping {
  id            String   @id @default(cuid())
  personName    String
  role          String // "감독" | "배우"
  kmdbId        String?
  koficPeopleCd String?
  tmdbId        String?
  note          String?
  createdAt     DateTime @default(now())

  @@unique([personName, role])
}

// 1:1 문의·오류 제보 — 유저가 제출하고 관리자가 상태를 바꿔준다.
model Inquiry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String // "영화 정보 오류" | "신규 영화 추가 요청" | "버그 신고" | "기타 문의"
  title      String
  content    String
  images     Json     @default("[]") // base64 data URI 배열 (최대 5장, 클라이언트에서 리사이즈)
  status     String   @default("답변 대기") // "답변 대기" | "처리 완료"
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

// 서비스 공지사항 — DB에 직접 INSERT하거나 관리 스크립트로 관리한다.
model Notice {
  id        String   @id @default(cuid())
  type      String // "업데이트" | "신규 기능" | "점검 안내" | "공지"
  title     String
  content   String?
  isNew     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 수상작 투표 — 사용자가 특정 영화제·시상 부문에 직접 투표한 영화.
// 1인 1표(userId + festival + awardCategory unique).
model AwardVote {
  id            String   @id @default(cuid())
  userId        String
  festival      String // "academy" | "cannes" | "berlin" | "venice"
  awardCategory String // "작품상" | "감독상" | ...
  movieId       String // kobis-* | wikidata-* 등
  movieTitle    String
  posterUrl     String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, festival, awardCategory])
  @@index([festival, awardCategory])
}

// 관리자가 직접 등록한 공식 수상작 — Wikidata fallback보다 우선 적용된다.
// 연도+영화제+부문 조합은 유일하다(upsert 기준).
model OfficialWinner {
  id            String   @id @default(cuid())
  year          Int // 시상식 연도 (예: 2025)
  festival      String // "academy" | "cannes" | "berlin" | "venice"
  awardCategory String // "작품상" | "황금종려상" | 등
  movieId       String // kobis-* | wikidata-* 등 내부 ID
  movieTitle    String
  posterUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([year, festival, awardCategory])
  @@index([festival, awardCategory])
}

// 부문별 득표 집계 캐시 — 투표/취소 시점에만 upsert하여 매 조회 때
// COUNT(*) GROUP BY 를 실행하지 않아도 된다.
model AwardVoteSummary {
  festival      String
  awardCategory String
  movieId       String
  movieTitle    String
  posterUrl     String?
  voteCount     Int     @default(0)

  @@id([festival, awardCategory, movieId])
  @@index([festival, awardCategory])
}

// 회원가입 약관 동의 기록 — 필수 동의(이용약관·개인정보 수집·이용·만 14세 이상)를 언제 어느
// 버전으로 했는지, 선택 동의(마케팅 정보 수신) 여부와 변경 시각을 남긴다. 동의 사실을
// 증명하고, 약관이 바뀌면(termsVersion이 다르면) 다시 동의를 받는 데 쓴다.
model TermsConsent {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion       String
  agreedAt           DateTime  @default(now())
  marketing          Boolean   @default(false)
  marketingUpdatedAt DateTime?
  updatedAt          DateTime  @updatedAt
}

// "스포일러 신고" — 한 회원은 한 리뷰를 한 번만 신고할 수 있다. 서로 다른 신고자가
// SPOILER_REPORT_THRESHOLD명이 되면 그 리뷰를 자동으로 스포일러로 표시한다.
model SpoilerReport {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

// 관리자가 막은 예고편 영상(YouTube key). TMDB가 공식 영상으로 내려줘도 여기 있으면 안 보여준다.
model BlockedVideoKey {
  videoKey  String   @id
  movieCd   String? // 어느 영화 페이지에서 막았는지(참고용)
  reason    String?
  createdBy String? // 막은 관리자 userId
  createdAt DateTime @default(now())
}

// TMDB /movie/{id}/videos 결과 캐시(영화당 24시간). TMDB 호출이 실패하면 마지막으로
// 성공한 결과를 그대로 쓴다. videos에는 공식·YouTube·허용 유형으로 거르고 정렬한 목록을 저장한다.
model TrailerCache {
  tmdbId    String   @id
  videos    Json
  fetchedAt DateTime @default(now())
}

// "이 영화를 좋아한 사람들이 본" — 회원 평점 기반 아이템-아이템 코사인 유사도.
// scripts/compute-movie-similarity.mts 또는 /api/cron/movie-similarity가 매일 다시 계산해
// 영화마다 상위 40개만 저장한다. 누가 무엇을 좋아했는지는 저장하지 않는다(집계값만).
model MovieSimilarity {
  movieCd        String
  similarMovieCd String
  score          Float // co / sqrt(|L(A)|·|L(B)|)
  coLikes        Int // 두 영화를 모두 좋아한 회원 수
  updatedAt      DateTime @default(now())

  @@id([movieCd, similarMovieCd])
  @@index([movieCd, score])
}

// 협업 필터링(CF)용 영화 간 유사도 — "추천 N%"에 비슷한 취향 회원들의 평가를 섞을 때 쓴다(cf-similarity-compute.ts).
// 위 MovieSimilarity("이 영화를 좋아한 사람들이 본", 좋아요 동시 등장)와 계산식이 달라 따로 둔다.
// 사용자 평균을 뺀 평점의 코사인 유사도를 공동 평가자 수로 축소한 값(sim')만 저장한다 — 회원 정보는 없다.
model MovieCfSimilarity {
  movieCd    String
  neighborCd String
  similarity Float // sim × n / (n + λ)
  coRaters   Int // 두 영화를 모두 평가한 회원 수(n)
  updatedAt  DateTime @default(now())

  @@id([movieCd, neighborCd])
  @@index([movieCd, similarity])
}

// CF 전역 통계(한 줄, id = "global") — 야간 크론이 세어 두고, 요청 때는 이 값만 읽어 CF를 켤지 정한다.
// cursor는 영화 유사도 계산을 여러 번에 나눠 할 때 이어서 시작할 위치(movieCd)다.
model CfStats {
  id            String    @id
  totalRatings  Int
  ratingUsers   Int
  pairCount     Int       @default(0)
  avgCoRaters   Float     @default(0)
  cursor        String?
  passStartedAt DateTime?
  lastPassAt    DateTime? // 전체 영화 계산을 마지막으로 끝낸 시각
  lastRunAt     DateTime  @default(now()) // 크론이 마지막으로 실행된 시각
}

// 예고편 채널 규칙(관리자). 기본 공식 채널 목록(official-channels.ts)에 없는 배급사 채널을 허용하거나
// (allowed=true), 목록에 있어도 막을(allowed=false) 때 쓴다. channelKey는 "@handle" 또는 "channel/UC…".
model TrailerChannelRule {
  channelKey  String   @id
  channelName String?
  allowed     Boolean
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
