// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 영화 상세정보 캐시(KOBIS+KMDb를 합쳐 만든 결과) — 특정 영화 하나를 볼 때만
// 필요한 long-tail 데이터라, 요청이 들어올 때 없거나 오래됐으면 그때 채워 넣는다
// (lazy cache).
model CachedMovie {
  movieCd        String   @id
  title          String
  titleEn        String?
  posterUrl      String?
  overview       String?
  releaseDate    String? // ISO yyyy-mm-dd
  rereleaseDate  String?
  runtimeMinutes Int?
  watchGrade     String?
  genreAlt       String?
  directorName   String?
  directorKmdbId String?
  cast           Json // { name: string; kmdbId: string | null }[]
  updatedAt      DateTime @updatedAt
}

// 인물 필모그래피 캐시 — 마찬가지로 그 인물 페이지를 볼 때만 필요한 long-tail
// 데이터라 lazy cache로 채운다.
model CachedPerson {
  kmdbId       String   @id
  name         String
  role         String // "감독" | "배우"
  filmography  Json // RowMovie[]
  updatedAt    DateTime @updatedAt
}

// 박스오피스 순위·이 달의 Best처럼 자주 조회되는 랭킹류 목록 — 요청마다 새로
// 계산하지 않고 하루 1~2회 배치로 미리 갱신해둔다.
model RankingSnapshot {
  id         Int      @id @default(autoincrement())
  listType   String // "weekly_box_office" | "monthly_best" 등
  rank       Int
  movieCd    String
  movieTitle String
  audiAcc    Int
  syncedAt   DateTime @default(now())

  @@index([listType, syncedAt])
}

// ── 로그인 (Auth.js) ─────────────────────────────────────────────────────
// User/Account/Session/VerificationToken은 Auth.js의 PrismaAdapter가 요구하는
// 정확한 형태 그대로다 — 필드명을 바꾸면 어댑터가 못 찾는다. nickname/totalLikes만
// 이 사이트에서 쓰려고 추가한 필드.
// 참고: https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String? // OAuth 제공자가 준 원래 이름
  nickname      String? // 사이트에서 실제로 보여주는 이름 — 처음엔 name으로 채우고 나중에 바꿀 수 있게
  email         String?   @unique // 카카오는 이메일 동의를 안 받은 앱이면 안 줄 수도 있어 nullable
  emailVerified DateTime?
  image         String?
  totalLikes    Int       @default(0) // 등급(관객/씨네필/평론가/거장) 계산용 반정규화

  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  reviewLikes   ReviewLike[]
  following     Follow[]       @relation("Following")
  followers     Follow[]       @relation("Followers")
  watchTriggers WatchTrigger[] @relation("Reader")

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── 리뷰·평점 소셜 기능 ──────────────────────────────────────────────────

model Review {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  movieCd String
  // "전체" | "연출" | "연기" | "각본" | "음악" | "편집" — category-ratings-store.ts의
  // RATING_CATEGORIES와 같은 값을 그대로 쓴다(번역 레이어 없이 1:1 매칭).
  category String @default("전체")
  type     ReviewType
  content  String
  rating   Float // 한줄평 0~10, 장문평 0~100 — 지금 화면 스케일 그대로

  hasSpoiler   Boolean  @default(false)
  spoilerLevel Int      @default(0)
  likeCount    Int      @default(0) // 반정규화 — 좋아요 받을 때마다 트랜잭션으로 같이 갱신
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  likes         ReviewLike[]
  watchTriggers WatchTrigger[]

  @@index([movieCd, category, type])
  @@index([userId])
}

enum ReviewType {
  SHORT
  LONG
}

// 리뷰 좋아요 — 등급(관객/씨네필/평론가/거장) 계산의 핵심 데이터.
model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

// 평론가 팔로우.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// "이 리뷰 때문에 봤어요" 추적.
model WatchTrigger {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  readerId  String
  reader    User     @relation("Reader", fields: [readerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, readerId])
}
